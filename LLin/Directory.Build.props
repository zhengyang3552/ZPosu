<!--
  Third-party code (LLin / Hikariii, MIT) is vendored under this directory so that it is
  compiled against this repository's osu.Game/osu.Framework sources instead of the NuGet
  versions it was originally built against.

  This file deliberately does NOT import the repository-root Directory.Build.props: upstream
  analyzer strictness (banned APIs, code style enforced as errors) is not appropriate for
  code we do not own.
-->
<Project>
  <PropertyGroup Label="C#">
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo Condition="'$(Configuration)'=='Debug'">false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416;CS1591;NU1701;NU1902;NU1903</NoWarn>
    <RunAnalyzers>false</RunAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup Label="NuGet audit">
    <!--
      Mirrors the suppression in the repository-root Directory.Build.props, which this subtree
      deliberately does not import. These projects resolve SixLabors.ImageSharp 3.1.11
      transitively via ppy.osu.Framework, so the pin below matches the version already in the
      graph and only exists to carry the NoWarn metadata (CI builds with -warnaserror).
    -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11">
      <NoWarn>NU1902,NU1903</NoWarn>
    </PackageReference>
  </ItemGroup>
</Project>
